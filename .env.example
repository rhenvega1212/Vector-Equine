# ===========================================
# VECTOR EQUINE ENVIRONMENT VARIABLES
# ===========================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# -------------------------------------------
# Supabase Configuration (Required)
# -------------------------------------------
# Get these from your Supabase project dashboard:
# Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Service role key (server-side only, never expose to client)
# Used for admin operations that bypass RLS
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Storage: for large challenge videos, raise the global file size limit in Supabase Dashboard
# → Project → Storage → Configuration (e.g. 5 GiB or higher on Pro). Local dev: supabase/config.toml [storage] file_size_limit.

# -------------------------------------------
# App Configuration (Required for Production)
# -------------------------------------------
# Your production domain (used for CORS, redirects, sitemap)
NEXT_PUBLIC_APP_URL=https://vectorequine.com

# -------------------------------------------
# Email Configuration (Optional)
# -------------------------------------------
# Configure in Supabase Dashboard > Authentication > Email Templates
# Supabase handles email sending, but you can customize templates

# -------------------------------------------
# Stripe Configuration (Required for Payments)
# -------------------------------------------
# Get these from your Stripe Dashboard:
# https://dashboard.stripe.com/apikeys

# Publishable key (safe for frontend)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Secret key (server-side only, NEVER expose to client)
STRIPE_SECRET_KEY=sk_test_your_secret_key

# Webhook signing secret (from Stripe CLI or Dashboard > Webhooks)
# For local testing: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# -------------------------------------------
# Cron (REQUIRED in production)
# -------------------------------------------
# Guards /api/cron/seed-posts, which seeds bot posts and runs an engagement
# pass. Vercel Cron sends this automatically as Authorization: Bearer <value>
# once the variable exists. Without it the route refuses to run in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# CRON_SECRET=

# -------------------------------------------
# Analytics (Optional)
# -------------------------------------------
# Vercel Analytics (automatically enabled on Vercel)
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# -------------------------------------------
# Error Monitoring (Optional but Recommended)
# -------------------------------------------
# Sentry DSN for error tracking
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# -------------------------------------------
# Feature Flags (Optional)
# -------------------------------------------
# NEXT_PUBLIC_ENABLE_AI_FEATURES=false
# NEXT_PUBLIC_ENABLE_ANALYTICS=true

# -------------------------------------------
# LiveKit — Capture Live headset call (Brief 11)
# -------------------------------------------
# Cloud: https://cloud.livekit.io → Project → Settings → Keys
# URL looks like: wss://your-project.livekit.cloud
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret
# Optional public mirror (same as LIVEKIT_URL)
# NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
# Optional guest join token HMAC (falls back to LIVEKIT_API_SECRET)
# CAPTURE_JOIN_SECRET=

# -------------------------------------------
# Capture Live — Whisper (OpenAI) for accurate lesson transcripts
# -------------------------------------------
# Browser speech is still used live; Whisper re-transcribes uploaded mic
# audio when the lesson is polished. Add one of:
OPENAI_API_KEY=
# AI_GATEWAY_API_KEY=   # optional alternative via Vercel AI Gateway

# -------------------------------------------
# Edge / Jetson (synced video) — Phases 0–1
# -------------------------------------------
# Pair a device via POST /api/edge/devices/pair while logged in as the rider.
# Optional HMAC secret for edge session tokens (falls back to CAPTURE_JOIN_SECRET)
# EDGE_INGEST_SECRET=

# -------------------------------------------
# Ask Vector (Claude) — Debrief ride chat / voice room
# -------------------------------------------
# https://console.anthropic.com/ → API keys
# Also set on Vercel for production
ANTHROPIC_API_KEY=

# ElevenLabs TTS for spoken answers in the Ask room
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Optional — defaults to Rachel if unset
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5
